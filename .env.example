# Environment variables — copy this file to `.env` and fill in real values.
# `.env` is gitignored; never commit real credentials.

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# Supabase Postgres connection string.
# Find it in Supabase → Project Settings → Database → Connection string (URI).
#
# Use the Supavisor pooler (IPv4) — works on networks without IPv6 and on Vercel:
DATABASE_URI=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres
#
# Direct host (IPv6-only) — faster for `payload db push`/migrations if your
# network supports IPv6:
# DATABASE_URI=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Payload CMS (required)
# -----------------------------------------------------------------------------
# Secret used to sign Payload auth tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=changeme

# Public base URL of the site (used for links, live preview, sitemaps).
# Set to the production domain when deploying.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase client (public — safe to expose to the browser)
# -----------------------------------------------------------------------------
# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# -----------------------------------------------------------------------------
# AISStream (required for live vessel tracking)
# -----------------------------------------------------------------------------
# API key for aisstream.io websocket feed. Server-only — never sent to the
# browser. Get a key at https://aisstream.io
AISSTREAM_API_KEY=

# -----------------------------------------------------------------------------
# Mapbox (public — safe to expose to the browser)
# -----------------------------------------------------------------------------
# Public (pk.*) token for the map. Restrict it to your domains in the Mapbox
# dashboard: https://account.mapbox.com/access-tokens
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk....

# -----------------------------------------------------------------------------
# Supabase Storage via S3 (optional — media uploads)
# -----------------------------------------------------------------------------
# Enables s3Storage for the `media` collection. Required on Vercel (read-only
# filesystem); if unset, uploads are stored on local disk.
# Supabase → Project Settings → Storage → S3 Connection Settings.
SUPABASE_S3_ENDPOINT=https://[PROJECT-REF].storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=[REGION]
SUPABASE_S3_BUCKET=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
# Public object URL prefix: Supabase serves public objects from
# /object/public/<bucket>/<key>, not the S3 endpoint path.
SUPABASE_S3_PUBLIC_URL=https://[PROJECT-REF].supabase.co/storage/v1/object/public/[BUCKET]
